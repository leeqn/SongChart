{
  "manifest_version": 3,
  "name": "SongChart",
  "version": "1.0",
  "description": "Scrobble tracks directly to SongChart using your API Key.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SongChart Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.soundcloud.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}